module picorv32_rtl1_tessent_edt_c1_controller(edt_clock, edt_update, edt_configuration, 
                                               edt_low_power_shift_en, edt_channels_in, 
                                               edt_decompressor_out, edt_channels_out_from_controller, 
                                               masks_for_compactor_0, masks_for_compactor_1, 
                                               edt_scan_in);
  input  [59:0] edt_decompressor_out;
  input  [1:0] edt_channels_in;
  input  edt_clock, edt_update, edt_configuration, edt_low_power_shift_en;
  output [59:0] edt_scan_in;
  output [29:0] masks_for_compactor_0, masks_for_compactor_1;
  output [1:0] edt_channels_out_from_controller;

  wire [59:0] config1_onehot_decoded_masks_0;
  wire [29:0] config0_onehot_decoded_masks_0, config0_onehot_decoded_masks_1, 
              onehot_decoded_masks_0, onehot_decoded_masks_1, 
              xor_decoded_masks_0, xor_decoded_masks_1;
  wire [17:0] config0_xor_encoded_masks, config1_xor_encoded_masks, 
              xor_encoded_masks;
  wire [9:0] masks_shift_reg_0, masks_hold_reg_0, 
             config1_plugin_xor_encoded_masks;
  wire [8:0] masks_shift_reg_1, masks_hold_reg_1;
  wire [5:0] config1_onehot_encoded_masks_0;
  wire [4:0] config0_onehot_encoded_masks_0, config0_onehot_encoded_masks_1;
  wire [1:0] edt_channels_out_from_low_power_shift_control;
  wire control_bit, config0_masks_shift_reg_1_in, masks_shift_reg_sync_reset, 
       rtlc0_masks_shift_reg_0_SS1_n5_0, rtlc0_masks_shift_reg_0_SS1_n5_1, 
       rtlc0_masks_shift_reg_0_SS1_n5_2, rtlc0_masks_shift_reg_0_SS1_n5_3, 
       rtlc0_masks_shift_reg_0_SS1_n5_4, rtlc0_masks_shift_reg_0_SS1_n5_5, 
       rtlc0_masks_shift_reg_0_SS1_n5_6, rtlc0_masks_shift_reg_0_SS1_n5_7, 
       rtlc0_masks_shift_reg_0_SS1_n5_8, rtlc0_masks_shift_reg_0_SS1_n5_9, 
       rtlc0_masks_shift_reg_1_SS1_n6_0, rtlc0_masks_shift_reg_1_SS1_n6_1, 
       rtlc0_masks_shift_reg_1_SS1_n6_2, rtlc0_masks_shift_reg_1_SS1_n6_3, 
       rtlc0_masks_shift_reg_1_SS1_n6_4, rtlc0_masks_shift_reg_1_SS1_n6_5, 
       rtlc0_masks_shift_reg_1_SS1_n6_6, rtlc0_masks_shift_reg_1_SS1_n6_7, 
       rtlc0_masks_shift_reg_1_SS1_n6_8, rtlcClkX, rtlcXXX, rtlcn71;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  picorv32_rtl1_tessent_edt_c1_low_power_shift_controller low_power_shift_controller_i(
      .edt_clock(edt_clock), .edt_update(edt_update), .edt_configuration(edt_configuration), 
      .edt_low_power_shift_en(edt_low_power_shift_en), .edt_channels_in(edt_channels_in), 
      .edt_decompressor_out(edt_decompressor_out), .edt_channels_out_from_low_power_shift_control(edt_channels_out_from_low_power_shift_control), 
      .edt_scan_in(edt_scan_in)
  );
  picorv32_rtl1_tessent_edt_c1_plugin_xor_decoder plugin_xor_decoder(
      .encoded_masks(config1_plugin_xor_encoded_masks), .decoded_masks(config1_xor_encoded_masks)
  );
  picorv32_rtl1_tessent_edt_c1_xor_decoder xor_decoder(
      .encoded_masks(xor_encoded_masks), .decoded_masks_0(xor_decoded_masks_0), 
      .decoded_masks_1(xor_decoded_masks_1)
  );
  picorv32_rtl1_tessent_edt_c1_onehot_decoder_5_to_30 config0_decoder1(
      .encoded_masks(config0_onehot_encoded_masks_0), .decoded_masks(config0_onehot_decoded_masks_0)
  );
  picorv32_rtl1_tessent_edt_c1_onehot_decoder_5_to_30 config0_decoder2(
      .encoded_masks(config0_onehot_encoded_masks_1), .decoded_masks(config0_onehot_decoded_masks_1)
  );
