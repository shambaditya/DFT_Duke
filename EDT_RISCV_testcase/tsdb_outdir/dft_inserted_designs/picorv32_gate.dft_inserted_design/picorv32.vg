       rtlcN9, rtlcN10, rtlcN11, rtlcN12, rtlcN13, rtlcN14;

  RTLC_OR4 rtlcm_0(
      .Z(rtlcN0), .A(in1), .B(in2), .C(in3), .D(in4)
  );
