iProcsForModule picorv32_rtl1_tessent_edt_c1
iProc setup {args} {
   if {[expr [llength $args]%2 != 0]} {
      display_message -error "Odd number of arguments. Expecting parameter and value pairs."
      return -code error
   }

   set edt_configuration low_compression
   set edt_low_power_shift_en 0
   set edt_bypass 0
   foreach {param value} $args {
      set param [string tolower $param]
      if {$param eq "edt_configuration"} {
         set edt_configuration $value
      } elseif {$param eq "edt_low_power_shift_en"} {
         set edt_low_power_shift_en $value
      } elseif {$param eq "edt_bypass"} {
         set edt_bypass $value
      } else {
         display_message -error "Invalid parameter '$param'. Valid parameters are 'edt_configuration', 'edt_low_power_shift_en' and 'edt_bypass'."
         return -code error
      }
      if {$param eq "edt_configuration"} {
         if {$value eq "low_compression" || $value eq "high_compression" || [string is boolean -strict $value]} {
            set edt_configuration $value
         } else {
            display_message -error "Invalid EDT configuration value '$value'. Valid values are boolean, 'low_compression' and 'high_compression'."
            return -code error
         }
      } elseif {![string is boolean -strict $value]} {
         display_message -error "Invalid non-boolean value '$value' for parameter '$param'."
         return -code error
      }
   }

   if {![string is boolean -strict $edt_configuration]} {
      iWrite edt_configuration $edt_configuration
   } elseif {$edt_configuration} {
      iWrite edt_configuration high_compression
   } else {
      iWrite edt_configuration low_compression
   }
   if {$edt_low_power_shift_en} {
      iWrite edt_low_power_shift_en on
   } else {
      iWrite edt_low_power_shift_en off
   }
   if {$edt_bypass} {
      iWrite edt_bypass on
   } else {
      iWrite edt_bypass off
   }
   iApply
}


