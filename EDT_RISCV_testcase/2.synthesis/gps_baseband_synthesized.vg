module time_base(clk, rstn, tic_divide, accum_divide, sample_clk, pre_tic_enable, 
                 tic_enable, accum_enable, accum_sample_enable, tic_count, accum_count);
  input  [23:0] tic_divide, accum_divide;
  input  clk, rstn;
  output [23:0] tic_count, accum_count;
  output sample_clk, pre_tic_enable, tic_enable, accum_enable, 
         accum_sample_enable;

  wire [23:0] tic_q, accum_q;
  wire [3:0] sc_q;
  wire tic_shift, rtlcn0, rtlcClkX, rtlcXXX, rtlc0_tic_shift_SS1_n3, rtlcn106, 
       rtlcn152, rtlcn154, rtlcn155, rtlcn156, rtlcn157, rtlcn158, rtlcn159, 
       rtlcn160, rtlcn161, rtlcn162, rtlcn163, rtlcn164, rtlcn165, rtlcn166, 
       rtlcn167, rtlcn168, rtlcn169, rtlcn170, rtlcn171, rtlcn172, rtlcn173, 
       rtlcn174, rtlcn175, rtlcn176, rtlcn177, rtlcn178, rtlcn179, rtlcn180, 
