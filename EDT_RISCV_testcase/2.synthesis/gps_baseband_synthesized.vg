  supply1 rtlcVcc;

  lpm_counter sc(
      .clock(clk), .sclr(rtlcn0), .q(sc_q)
  );
  lpm_counter_ud te(
      .clock(clk), .sclr(rtlcn0), .sload(pre_tic_enable), .data(tic_divide), .q(tic_q)
  );
  lpm_counter_ud ae(
      .clock(clk), .sclr(rtlcn0), .sload(accum_enable), .data(accum_divide), .q(accum_q)
  );
  RTLC_BUF rtlc0_6(
      .Z(tic_count[0]), .A(tic_q[0])
  );
