module tracking_channel(clk, rstn, accum_sample_enable, if_sign, if_mag, pre_tic_enable, 
                        tic_enable, carr_nco_fc, code_nco_fc, prn_key, prn_key_enable, 
                        code_slew, slew_enable, epoch_enable, dump, i_early, q_early, 
                        i_prompt, q_prompt, i_late, q_late, carrier_val, code_val, 
                        epoch_load, epoch, epoch_check);
  input  [28:0] carr_nco_fc;
  input  [27:0] code_nco_fc;
  input  [10:0] code_slew, epoch_load;
  input  [9:0] prn_key;
  input  clk, rstn, accum_sample_enable, if_sign, if_mag, pre_tic_enable, 
         tic_enable, prn_key_enable, slew_enable, epoch_enable;
  output [31:0] carrier_val;
  output [20:0] code_val;
  output [15:0] i_early, q_early, i_prompt, q_prompt, i_late, q_late;
  output [10:0] epoch, epoch_check;
  output dump;

  wire [2:0] mix_i_mag, mix_q_mag;
  wire carrier_i_sign, carrier_q_sign, carrier_i_mag, carrier_q_mag, 
       mix_i_sign, mix_q_sign, hc_enable, dump_enable, early_code, prompt_code, 
       late_code;

  assign dump = dump_enable;
  carrier_mixer i_cos(
      .if_sign(if_sign), .if_mag(if_mag), .carrier_sign(carrier_i_sign), .carrier_mag(carrier_i_mag), 
      .mix_sign(mix_i_sign), .mix_mag(mix_i_mag)
  );
  carrier_mixer q_sin(
      .if_sign(if_sign), .if_mag(if_mag), .carrier_sign(carrier_q_sign), .carrier_mag(carrier_q_mag), 
      .mix_sign(mix_q_sign), .mix_mag(mix_q_mag)
  );
  carrier_nco carrnco(
      .clk(clk), .rstn(rstn), .tic_enable(tic_enable), .f_control(carr_nco_fc), 
      .carrier_val(carrier_val), .i_sign(carrier_i_sign), .i_mag(carrier_i_mag), 
      .q_sign(carrier_q_sign), .q_mag(carrier_q_mag)
  );
  code_nco codenco(
      .clk(clk), .rstn(rstn), .tic_enable(pre_tic_enable), .f_control(code_nco_fc), 
      .hc_enable(hc_enable), .code_nco_phase(code_val[9:0])
  );
  code_gen codegen(
      .clk(clk), .rstn(rstn), .tic_enable(tic_enable), .hc_enable(hc_enable), .prn_key_enable(prn_key_enable), 
      .prn_key(prn_key), .code_slew(code_slew), .slew_enable(slew_enable), .dump_enable(dump_enable), 
      .code_phase(code_val[20:10]), .early(early_code), .prompt(prompt_code), .late(late_code)
  );
  epoch_counter epc(
      .clk(clk), .rstn(rstn), .tic_enable(tic_enable), .dump_enable(dump_enable), 
      .epoch_enable(epoch_enable), .epoch_load(epoch_load), .epoch(epoch), .epoch_check(epoch_check)
  );
  accumulator ie(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(early_code), 
      .carrier_mix_sign(mix_i_sign), .carrier_mix_mag(mix_i_mag), .dump_enable(dump_enable), 
      .accumulation(i_early)
  );
  accumulator ip(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(prompt_code), 
      .carrier_mix_sign(mix_i_sign), .carrier_mix_mag(mix_i_mag), .dump_enable(dump_enable), 
      .accumulation(i_prompt)
  );
  accumulator il(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(late_code), 
      .carrier_mix_sign(mix_i_sign), .carrier_mix_mag(mix_i_mag), .dump_enable(dump_enable), 
      .accumulation(i_late)
  );
  accumulator qe(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(early_code), 
      .carrier_mix_sign(mix_q_sign), .carrier_mix_mag(mix_q_mag), .dump_enable(dump_enable), 
      .accumulation(q_early)
  );
  accumulator qp(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(prompt_code), 
      .carrier_mix_sign(mix_q_sign), .carrier_mix_mag(mix_q_mag), .dump_enable(dump_enable), 
      .accumulation(q_prompt)
  );
  accumulator ql(
      .clk(clk), .rstn(rstn), .sample_enable(accum_sample_enable), .code(late_code), 
      .carrier_mix_sign(mix_q_sign), .carrier_mix_mag(mix_q_mag), .dump_enable(dump_enable), 
      .accumulation(q_late)
  );
endmodule

module gps_baseband_rtl1_tessent_clk_gate_and(clk, fe, te, clkg);
  input  clk, fe, te;
  output clkg;

  wire fe_te, latch, rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_AND2 rtlc1_3(
      .Z(clkg), .A(clk), .B(latch)
  );
  RTLC_OR2 rtlc_12(
      .Z(fe_te), .A(fe), .B(te)
  );
  RTLC_LDN rtlcreg_latch(
      .Q(latch), .D(fe_te), .GN(clk)
  );
endmodule

module gps_baseband_rtl1_tessent_inv(input a, output y);
  not gate(
      y, a
  );
endmodule

module gps_baseband_rtl1_tessent_clk_buf(input a, output y);
  buf gate(
      y, a
  );
endmodule

module gps_baseband_rtl1_tessent_buf(input a, output y);
  buf gate(
      y, a
  );
endmodule

module gps_baseband_rtl1_tessent_posedge_synchronizer_reset(rn, d, clk, q);
  input  rn, d, clk;
  output q;

  wire ntc_retiming_q_reg, rtlcClkX, rtlcXXX, rtlcn30;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_INV rtlc_17(
      .Z(rtlcn30), .A(rn)
  );
  RTLC_FDC rtlcreg_q(
      .Q(q), .D(ntc_retiming_q_reg), .CP(clk), .CLR(rtlcn30)
  );
  RTLC_FDC rtlcreg_ntc_retiming_q_reg(
      .Q(ntc_retiming_q_reg), .D(d), .CP(clk), .CLR(rtlcn30)
  );
endmodule

module gps_baseband_rtl1_tessent_clk_mux2(a, b, s, y);
  input  a, b, s;
  output y;

  wire rtlcClkX, rtlcXXX;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  M_RTLSIM_MUXN_2_1 rtlc0_1(
      .Z(y), .in_1(b), .in_0(a), .sel_0(s)
  );
endmodule

module gps_baseband_rtl1_tessent_occ_shift_reg(clk, scan_en, capture_cycle_width, 
                                               some_ones_left, scan_in, scan_out);
  input  [1:0] capture_cycle_width;
  input  clk, scan_en, scan_in;
  output some_ones_left, scan_out;

  wire [2:0] FF;
  wire scan_in_gated, rtlc0_FF_SS1_n2_0, rtlc0_FF_SS1_n2_1, rtlc0_FF_SS1_n2_2, 
       rtlc0_PS4_n17, rtlcClkX, rtlcXXX, rtlcn39, rtlcn40, rtlcn41;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  RTLC_BUF rtlc1_2(
      .Z(scan_out), .A(FF[0])
  );
  RTLC_AND2 rtlc1_3(
      .Z(scan_in_gated), .A(scan_in), .B(scan_en)
  );
  M_RTLSIM_MUXN_4_2 rtlc_29(
      .Z(rtlc0_FF_SS1_n2_1), .in_3(FF[2]), .in_2(FF[2]), .in_1(scan_in_gated), 
      .in_0(1'b0), .sel_1(capture_cycle_width[1]), .sel_0(capture_cycle_width[0])
  );
  M_RTLSIM_MUXN_2_1 rtlc_30(
      .Z(rtlc0_FF_SS1_n2_0), .in_1(scan_in_gated), .in_0(FF[1]), .sel_0(rtlc0_PS4_n17)
  );
  RTLC_AND2 rtlc_34(
      .Z(rtlc0_FF_SS1_n2_2), .A(scan_in_gated), .B(capture_cycle_width[1])
  );
  RTLC_INV rtlc_35(
      .Z(rtlcn39), .A(capture_cycle_width[1])
  );
  RTLC_INV rtlc_36(
      .Z(rtlcn40), .A(capture_cycle_width[0])
  );
  RTLC_AND2 rtlc_40(
      .Z(rtlc0_PS4_n17), .A(rtlcn39), .B(rtlcn40)
  );
  RTLC_OR2 rtlc_41(
      .Z(rtlcn41), .A(FF[0]), .B(FF[1])
  );
  RTLC_OR2 rtlc_42(
      .Z(some_ones_left), .A(rtlcn41), .B(FF[2])
  );
  RTLC_FD rtlcreg_FF_2(
      .Q(FF[2]), .D(rtlc0_FF_SS1_n2_2), .CP(clk)
  );
  RTLC_FD rtlcreg_FF_1(
      .Q(FF[1]), .D(rtlc0_FF_SS1_n2_1), .CP(clk)
  );
  RTLC_FD rtlcreg_FF_0(
      .Q(FF[0]), .D(rtlc0_FF_SS1_n2_0), .CP(clk)
  );
endmodule

module gps_baseband_rtl1_tessent_occ_control(fast_clock, slow_clock, bypass_clock, 
                                             scan_en, test_mode, fast_capture_mode, 
                                             capture_cycle_width, shift_only_mode, 
                                             slow_clock_en, clock_mux_select, fast_clock_en, 
                                             scan_in, scan_out);
  input  [1:0] capture_cycle_width;
  input  fast_clock, slow_clock, bypass_clock, scan_en, test_mode, 
         fast_capture_mode, shift_only_mode, scan_in;
  output slow_clock_en, clock_mux_select, fast_clock_en, scan_out;

  wire SCAN_EN_inv_sync, ShiftReg_EN, BYPASS_SHIFT_FF, SCAN_OUT_d, 
       ShiftReg_SCAN_OUT, SHIFT_REG_CLK_en, SHIFT_REG_CLK_G, SHIFT_REG_CLK, 
       SE_SLOW_CLK_inv, rtlcn0, rtlcn1, rtlc0n17, rtlc0n18, rtlc0n20, rtlc0n22, 
       rtlc0n26, rtlc0n27, rtlc0n31, rtlc0n32, rtlc0n33, rtlc0n34, rtlc0n38, 
       rtlcClkX, rtlcXXX, rtlc2n12, rtlc2_neg_clk_n16, rtlc3n6, rtlc4n6, 
       rtlc4_neg_clk_n9;
  supply0 rtlcVss;
  supply1 rtlcVcc;

  gps_baseband_rtl1_tessent_posedge_synchronizer_reset tessent_persistent_cell_ltest_ntc_sync_cell(
      .rn(rtlcn0), .d(SE_SLOW_CLK_inv), .clk(fast_clock), .q(SCAN_EN_inv_sync)
  );
  gps_baseband_rtl1_tessent_clk_gate_and tessent_persistent_cell_cgc_SHIFT_REG_CLK(
      .clk(fast_clock), .fe(SHIFT_REG_CLK_en), .te(SHIFT_REG_CLK_en), .clkg(SHIFT_REG_CLK_G)
  );
  gps_baseband_rtl1_tessent_clk_mux2 tessent_persistent_cell_SHIFT_REG_CLK_mux(
      .a(SHIFT_REG_CLK_G), .b(slow_clock), .s(rtlcn1), .y(SHIFT_REG_CLK)
  );
  gps_baseband_rtl1_tessent_occ_shift_reg ShiftReg(
      .clk(SHIFT_REG_CLK), .scan_en(scan_en), .capture_cycle_width(capture_cycle_width), 
      .some_ones_left(ShiftReg_EN), .scan_in(scan_in), .scan_out(ShiftReg_SCAN_OUT)
  );
  RTLC_INV rtlc0_8(
      .Z(rtlc0n20), .A(fast_capture_mode)
  );
  RTLC_INV rtlc0_9(
      .Z(rtlcn0), .A(rtlc0n18)
  );
  RTLC_INV rtlc0_11(
      .Z(rtlc0n17), .A(test_mode)
  );
  RTLC_AND2 rtlc0_12(
      .Z(SHIFT_REG_CLK_en), .A(rtlc0n22), .B(SCAN_EN_inv_sync)
  );
  RTLC_AND2 rtlc0_13(
      .Z(rtlc0n22), .A(test_mode), .B(ShiftReg_EN)
  );
  M_RTLSIM_MUXN_2_1 rtlc0_14(
      .Z(SCAN_OUT_d), .in_1(BYPASS_SHIFT_FF), .in_0(ShiftReg_SCAN_OUT), .sel_0(rtlc0n17)
  );
  RTLC_AND2 rtlc0_17(
      .Z(rtlc0n27), .A(rtlc0n26), .B(SCAN_EN_inv_sync)
  );
  RTLC_AND2 rtlc0_18(
      .Z(rtlc0n26), .A(ShiftReg_SCAN_OUT), .B(fast_capture_mode)
  );
  RTLC_AND2 rtlc0_21(
      .Z(rtlc0n33), .A(rtlc0n32), .B(test_mode)
  );
  RTLC_AND2 rtlc0_23(
      .Z(rtlc0n31), .A(ShiftReg_SCAN_OUT), .B(rtlc0n20)
  );
  RTLC_AND2 rtlc0_25(
      .Z(rtlc0n34), .A(shift_only_mode), .B(scan_en)
  );
  RTLC_AND2 rtlc0_27(
      .Z(rtlc0n38), .A(rtlcn1), .B(test_mode)
  );
  RTLC_INV rtlc2_0(
      .Z(rtlc2n12), .A(scan_en)
  );
  RTLC_INV rtlc2_2(
      .Z(rtlc2_neg_clk_n16), .A(slow_clock)
  );
  RTLC_AND2 rtlc3_0(
      .Z(rtlc3n6), .A(scan_in), .B(scan_en)
  );
  RTLC_AND2 rtlc4_0(
      .Z(rtlc4n6), .A(SCAN_OUT_d), .B(scan_en)
  );
  RTLC_INV rtlc4_2(
      .Z(rtlc4_neg_clk_n9), .A(bypass_clock)
  );
  RTLC_OR2 rtlc_50(
      .Z(rtlc0n18), .A(scan_en), .B(rtlc0n17)
  );
  RTLC_OR2 rtlc_51(
      .Z(rtlcn1), .A(scan_en), .B(rtlc0n20)
  );
  RTLC_OR2 rtlc_52(
      .Z(rtlc0n32), .A(rtlc0n31), .B(scan_en)
  );
  RTLC_OR2 rtlc_53(
      .Z(slow_clock_en), .A(rtlc0n33), .B(rtlc0n34)
  );
  RTLC_OR2 rtlc_54(
      .Z(clock_mux_select), .A(rtlc0n38), .B(rtlc0n34)
  );
  RTLC_OR2 rtlc_55(
      .Z(fast_clock_en), .A(rtlc0n27), .B(rtlc0n17)
  );
  RTLC_FD rtlcreg_BYPASS_SHIFT_FF(
      .Q(BYPASS_SHIFT_FF), .D(rtlc3n6), .CP(bypass_clock)
  );
  RTLC_FD rtlcreg_scan_out(
      .Q(scan_out), .D(rtlc4n6), .CP(rtlc4_neg_clk_n9)
  );
  RTLC_FDC rtlcreg_SE_SLOW_CLK_inv(
      .Q(SE_SLOW_CLK_inv), .D(rtlc2n12), .CP(rtlc2_neg_clk_n16), .CLR(rtlc0n17)
  );
endmodule

module gps_baseband_rtl1_tessent_occ(input fast_clock, slow_clock, scan_en, test_mode, fast_capture_mode, 
      input [1:0] capture_cycle_width, input shift_only_mode, output clock_out, 
      input scan_in, output scan_out);
  wire [1:0] capture_cycle_width_buf_out;
  wire fast_clock_en, slow_clock_en, slow_clock_gated, clock_mux_select, 
       fast_clock_gated, fast_clock_buf_out, slow_clock_buf_out, 
       scan_en_buf_out, test_mode_buf_out, fast_capture_mode_buf_out, 
       scan_in_buf_out, scan_out_buf_in;

  gps_baseband_rtl1_tessent_clk_buf tessent_persistent_cell_fast_clock_buf(
      .a(fast_clock), .y(fast_clock_buf_out)
  );
  gps_baseband_rtl1_tessent_clk_buf tessent_persistent_cell_slow_clock_buf(
      .a(slow_clock), .y(slow_clock_buf_out)
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_scan_en_buf(
      .a(scan_en), .y(scan_en_buf_out)
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_test_mode_buf(
      .a(test_mode), .y(test_mode_buf_out)
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_fast_capture_mode_buf(
      .a(fast_capture_mode), .y(fast_capture_mode_buf_out)
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_capture_cycle_width_buf_0(
      .a(capture_cycle_width[0]), .y(capture_cycle_width_buf_out[0])
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_capture_cycle_width_buf_1(
      .a(capture_cycle_width[1]), .y(capture_cycle_width_buf_out[1])
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_scan_in_buf(
      .a(scan_in), .y(scan_in_buf_out)
  );
  gps_baseband_rtl1_tessent_buf tessent_persistent_cell_scan_out_buf(
      .a(scan_out_buf_in), .y(scan_out)
  );
  gps_baseband_rtl1_tessent_occ_control occ_control(
      .fast_clock(fast_clock_buf_out), .slow_clock(slow_clock_buf_out), .bypass_clock(clock_out), 
      .scan_en(scan_en_buf_out), .test_mode(test_mode_buf_out), .fast_capture_mode(fast_capture_mode_buf_out), 
      .capture_cycle_width(capture_cycle_width_buf_out), .shift_only_mode(shift_only_mode), 
      .slow_clock_en(slow_clock_en), .clock_mux_select(clock_mux_select), .fast_clock_en(fast_clock_en), 
      .scan_in(scan_in_buf_out), .scan_out(scan_out_buf_in)
  );
  gps_baseband_rtl1_tessent_clk_gate_and tessent_persistent_cell_cgc_fast_clock(
      .clk(fast_clock_buf_out), .fe(fast_clock_en), .te(fast_clock_en), .clkg(fast_clock_gated)
  );
  gps_baseband_rtl1_tessent_clk_gate_and tessent_persistent_cell_cgc_slow_clock(
      .clk(slow_clock_buf_out), .fe(slow_clock_en), .te(slow_clock_en), .clkg(slow_clock_gated)
  );
  gps_baseband_rtl1_tessent_clk_mux2 tessent_persistent_cell_clock_out_mux(
      .a(fast_clock_gated), .b(slow_clock_gated), .s(clock_mux_select), .y(clock_out)
  );
endmodule

module gps_baseband_rtl1_tessent_edt_c1_decompressor(edt_clock, edt_update, edt_channels_in, 
                                                     edt_scan_in);
  input  [3:0] edt_channels_in;
