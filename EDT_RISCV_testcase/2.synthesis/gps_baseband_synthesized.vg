  );
  RTLC_BUF rtlc3_1(
      .Z(q[1]), .A(tmp[1])
  );
  RTLC_BUF rtlc3_2(
      .Z(q[2]), .A(tmp[2])
  );
  RTLC_FDCE rtlcreg_tmp_2(
      .Q(tmp[2]), .D(tmp[1]), .CP(clock), .CLR(sclr), .CE(enable)
  );
  RTLC_FDCE rtlcreg_tmp_1(
