module M_RTLSIM_INCR_4(cout, out_3, out_2, out_1, out_0, in_3, in_2, in_1, in_0, 
                       cin);
  input  in_3, in_2, in_1, in_0, cin;
  output cout, out_3, out_2, out_1, out_0;

  wire carry0, carry1, carry2;

  RTLC_HADD inst0(
      .S(out_0), .CO(carry0), .A(cin), .B(in_0)
  );
  RTLC_HADD inst1(
      .S(out_1), .CO(carry1), .A(carry0), .B(in_1)
  );
  RTLC_HADD inst2(
      .S(out_2), .CO(carry2), .A(carry1), .B(in_2)
  );
  RTLC_HADD inst3(
      .S(out_3), .CO(cout), .A(carry2), .B(in_3)
  );
endmodule

