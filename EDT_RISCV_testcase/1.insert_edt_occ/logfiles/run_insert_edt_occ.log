//             set_config_value clock_intercept_node -in $occ $clk
//           }
//  sub-command: add_config_element OCC/Controller(clk) -in /DftSpecification(picorv32,rtl1) 
//  sub-command: set_config_value clock_intercept_node -in {/DftSpecification(picorv32,rtl1)/OCC/Controller(clk)} clk 
//  command: report_config_data $spec

DftSpecification(picorv32,rtl1) {
  OCC {
    type : standard;
    Connections {
      StaticExternalControls {
        fast_capture_mode : fast_capture_mode;
        capture_cycle_width : capture_cycle_width_1, capture_cycle_width_0;
        test_mode : test_mode;
      }
    }
    Controller(clk) {
      clock_intercept_nodes : clk;
    }
  }
}
//  command: ## To EDT controller, the edt_clock and edt_update get auto connected
//  command: ## EDT includes built-in bypass
//  command: ## Scan chains need to be stitched using LE -TE flops, if not will get K22
//  command: ## Modify below to your specific design requirements
//  command: read_config_data -in $spec -from_string {
  EDT {
    Controller (c1) {
      longest_chain_range : 50, 65;
      scan_chain_count : 60;
      input_channel_count : 2;
      output_channel_count : 2;
      Connections {
        StaticExternalControls {
          edt_bypass : edt_bypass ;
          edt_low_power_shift_enable : edt_low_power_shift_en;
          edt_configuration : edt_configuration;
          edt_single_bypass_chain : edt_single_bypass_chain;
        }
      }
      HighCompressionConfiguration {
        present : on;
        input_channel_count : 1;
        output_channel_count : 1;
      }
      ShiftPowerOptions {
        present : on;
        full_control : on;
        min_switching_threshold_percentage : 15 ; // default = 15
      }
    }
  }
}
//  command: report_config_data $spec

DftSpecification(picorv32,rtl1) {
  OCC {
    type : standard;
    Connections {
      StaticExternalControls {
        fast_capture_mode : fast_capture_mode;
        capture_cycle_width : capture_cycle_width_1, capture_cycle_width_0;
        test_mode : test_mode;
      }
    }
    Controller(clk) {
      clock_intercept_nodes : clk;
    }
  }
  EDT {
    Controller(c1) {
      longest_chain_range : 50, 65;
      scan_chain_count : 60;
      input_channel_count : 2;
      output_channel_count : 2;
      Connections {
        StaticExternalControls {
          edt_bypass : edt_bypass;
          edt_low_power_shift_enable : edt_low_power_shift_en;
          edt_configuration : edt_configuration;
          edt_single_bypass_chain : edt_single_bypass_chain;
        }
      }
      HighCompressionConfiguration {
        present : on;
        input_channel_count : 1;
        output_channel_count : 1;
      }
      ShiftPowerOptions {
        present : on;
        full_control : on;
        min_switching_threshold_percentage : 15; // default = 15
      }
    }
  }
}
